# Use local demo data when true; keep false for API integration.
VITE_USE_MOCK=false

# ADX API base path and Vite development proxy target.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://10.193.144.133:8080

# LenovoId one-click login authorization endpoint.
# Parameters support placeholders such as {redirect_uri}, {state}, {client_id}, {scope}, and {response_type}.
VITE_LENOVO_AUTH_URL=
VITE_LENOVO_CLIENT_ID=
VITE_LENOVO_SCOPE=openid profile
VITE_LENOVO_RESPONSE_TYPE=token
